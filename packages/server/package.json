{
  "name": "@strikescope/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && node scripts/copy-migrations.mjs",
    "start": "node dist/index.js",
    "seed": "tsx scripts/seed.ts",
    "db:status": "node scripts/db-status.mjs",
    "build:geo": "tsx scripts/build-geo-reference.ts",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1062.0",
    "@googleapis/drive": "^8.14.0",
    "basic-ftp": "^5.0.5",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^11.7.0",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "libphonenumber-js": "^1.13.6",
    "mathjs": "^15.2.0",
    "multer": "^2.1.1",
    "nodemailer": "^8.0.10",
    "pino": "^9.0.0",
    "speakeasy": "^2.0.0",
    "ssh2": "^1.16.0",
    "string-similarity": "^4.0.4",
    "uuid": "^11.0.0",
    "ws": "^8.18.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.12",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^1.4.12",
    "@types/nodemailer": "^8.0.0",
    "@types/speakeasy": "^2.0.10",
    "@types/ssh2": "^1.15.1",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.5.13",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.0.0"
  }
}
