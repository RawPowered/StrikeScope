    <Var name="countyDepartment" entity="projects" api="county_department"/>
    <Var name="requiresPermit" entity="project_types" api="requires_permit"/>
    <Var name="includeFinancingFields" entity="project_types" api="include_financing_fields"/>
    <Var name="financingType" entity="projects" api="financing_type"/>
    <Var name="bankId" entity="projects" api="bank_id"/>
    <Var name="territoryConfig" entity="companies" api="territory_json"/>
    <Var name="mapsConfig" entity="companies" api="territory_json.maps" fields="apiKey,enableAddressAutocomplete,enableDirections,enableMapEmbed"/>
    <Var name="fieldPolicy" entity="companies" api="field_policy_json"/>
    <Var name="worksiteLat" entity="projects" api="worksite_lat"/>
    <Var name="worksiteLng" entity="projects" api="worksite_lng"/>
    <Var name="scheduledInstallAt" entity="projects" api="scheduled_install_at"/>
    <Var name="actionToken" source="field/Capture.tsx" scope="sessionStorage" key="field_action_token"/>
    <Var name="fieldJwt" source="field/api.ts" scope="localStorage" key="field_jwt"/>
  </Fields>
  <Repo>
    <Var name="GITHUB_REPO" value="https://github.com/GatoGodMode/StrikeScope" usedIn="README.md" purpose="Public repository"/>
    <Var name="SECURITY_IAM_DOC" value="docs/SECURITY-IAM.md" usedIn="README.md" purpose="IAM documentation"/>
    <Var name="SENTINEL_ROADMAP_DOC" value="docs/ROADMAP-SENTINEL.md" usedIn="README.md" purpose="Sentinel WIP roadmap"/>
  </Repo>
</VarMap>
